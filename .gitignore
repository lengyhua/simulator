# Go server build artifacts (reproducible — do not commit)
# CalcXRD.exe: 由 `cd server && bash build.sh` 重新生成（go build + go-bindata）
# static/calc-xrd-dist/: Junction → web/dist（build.sh 自动建/重建，非真实拷贝；
#   打包时 go-bindata 跟 Junction 走进 web/dist 生成 bindata，embed key 前缀
#   固定为 "static/calc-xrd-dist/"）
server/CalcXRD.exe
server/static/calc-xrd-dist/
# server/.omc/: OMC agent 会话状态（go-bindata 白名单 regen.sh/build.sh 会在打包前兜底检查，
# 但挡掉进 git 更稳妥）
server/.omc/

# 交叉验证脚本中间产物
scripts/tmp/

# OMC agent session-state junk (.omo/run-continuation/ etc.)
.omo/
server/CalcXRD.exe~
server/smoke-pid.txt
web/tmp_al_check.mjs
ghidra-out/
ghidra-out2/
ghidra/
ghidra-workspace/
